# Normalize line endings: LF in the repository and in the working tree.
# Without this, Windows checkouts produce CRLF-only diffs that have to be
# reverted by hand before every commit.
* text=auto eol=lf

# Generated / lockfiles — LF, and keep them out of diff review noise.
pnpm-lock.yaml text eol=lf linguist-generated=true

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.mp3  binary
*.mp4  binary
*.zip  binary
*.keystore binary
